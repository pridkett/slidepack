# Generated by .github/workflows/release.yml from
# .github/homebrew/slidepack.rb.tmpl. Do not edit in the tap by hand — the
# next release will overwrite it. Edit the template in pridkett/slidepack.
class Slidepack < Formula
  desc "Pack a presentation directory into a single self-contained HTML file"
  homepage "https://pridkett.github.io/slidepack"
  version "@@VERSION@@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/pridkett/slidepack/releases/download/v@@VERSION@@/slidepack_@@VERSION@@_darwin_arm64.tar.gz"
      sha256 "@@SHA_DARWIN_ARM64@@"
    end

    on_intel do
      url "https://github.com/pridkett/slidepack/releases/download/v@@VERSION@@/slidepack_@@VERSION@@_darwin_amd64.tar.gz"
      sha256 "@@SHA_DARWIN_AMD64@@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/pridkett/slidepack/releases/download/v@@VERSION@@/slidepack_@@VERSION@@_linux_arm64.tar.gz"
      sha256 "@@SHA_LINUX_ARM64@@"
    end

    on_intel do
      url "https://github.com/pridkett/slidepack/releases/download/v@@VERSION@@/slidepack_@@VERSION@@_linux_amd64.tar.gz"
      sha256 "@@SHA_LINUX_AMD64@@"
    end
  end

  def install
    bin.install "slidepack"
    doc.install "README.md"
    doc.install "docs" => "docs"
  end

  test do
    assert_match "\"name\":\"slidepack\"", shell_output("#{bin}/slidepack version --json")

    # A presentation is any directory with an entry document, so the smallest
    # honest end-to-end check is pack -> unpack -> compare bytes.
    (testpath/"deck").mkpath
    (testpath/"deck/index.html").write("<!doctype html><title>t</title><h1>hello</h1>\n")

    system bin/"slidepack", "pack", testpath/"deck", "-o", testpath/"deck.html"
    assert_path_exists testpath/"deck.html"

    system bin/"slidepack", "unpack", testpath/"deck.html", "--output", testpath/"out"
    assert_equal (testpath/"deck/index.html").read, (testpath/"out/index.html").read
  end
end
